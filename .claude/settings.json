{
  "permissions": {
    "allow": ["Bash", "Edit", "Write", "Read", "WebFetch", "WebSearch", "mcp__*"],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf ..:*)"
    ]
  }
}
