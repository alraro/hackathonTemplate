# Copy to .env (`make setup` does it). Works with zero keys: fixtures + browser TTS.
# Prune markers: `# >>> module:<x>` ... `# <<< module:<x>` around each Module's group.

# --- core ---
# Profiles started by `docker compose up` / `make up`. Default: every Module.
COMPOSE_PROFILES=web,api
WEB_PORT=5173
API_PORT=8000
DB_PORT=5433
# true on Windows/WSL bind mounts: enables Vite usePolling and WATCHFILES_FORCE_POLLING
DEV_POLLING=false
OUTPUT_LANGUAGE=

# >>> module:api
# Empty = auto-generated by `make setup`
SECRET_KEY=
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
# <<< module:api

# >>> module:web
# fixtures = no backend needed; live = call the API
VITE_API_MODE=fixtures
# <<< module:web

# >>> module:llm
LLM_PROVIDER=groq
LLM_MODEL_FAST=
LLM_MODEL_SMART=
LLM_CACHE=on
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# gemini | ollama (ollama adds the `ollama` profile on `make up`)
EMBED_PROVIDER=gemini
GEMINI_API_KEY=
STT_PROVIDER=groq
TTS_PROVIDER=browser
# Web speak helper: browser | server
VITE_TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
# <<< module:llm

# Used by `make share` to expose the stack
NGROK_AUTHTOKEN=
