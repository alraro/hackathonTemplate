  "radius": "0px",
  "shadow": {
    "sm": "2px 2px 0 0 var(--foreground)",
    "md": "4px 4px 0 0 var(--foreground)",
    "lg": "8px 8px 0 0 var(--foreground)"
  },
  "motion": {
    "duration": {
      "fast": 60,
      "base": 100,
      "slow": 180
    },
    "easing": {
      "standard": [0, 0, 1, 1],
      "emphasized": [0.9, 0, 0.1, 1]
    },
    "spring": {
      "stiffness": 900,
      "damping": 40,
      "mass": 0.6
    }
  },
  "focus": {
    "width": "3px",
    "offset": "0px"
  },
  "reducedMotion": {
    "duration": {
      "fast": 0,
      "base": 0,
      "slow": 0
    },
    "spring": {
      "stiffness": 1000,
      "damping": 100
    }
  },
  "effects": [
    "Marquee",
    "HardShadowPress",
    "GlitchText"
  ]
}
